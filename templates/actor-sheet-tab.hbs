<div class="beavers-crafting actor-tab bct">
  <div class="bct-bar">
    <div class="bct-sum">
      {{#if empty}}
        <span>{{localize "beaversCrafting.actorSheet.summary.none"}}</span>
      {{else}}
        {{#each summary}}<span><span class="bct-d {{cls}}"></span>{{text}}</span>{{/each}}
      {{/if}}
    </div>
    <button type="button" class="bct-add addCrafting">
      <i class="fas fa-hammer"></i>{{localize "beaversCrafting.actorSheet.add"}}
    </button>
  </div>

  {{#if empty}}
    <div class="bct-empty">
      <i class="fas fa-scroll"></i>
      <span>{{localize "beaversCrafting.actorSheet.emptyHint"}}</span>
    </div>
  {{else}}
    <div class="bct-list">
      {{> beavers-actor-tab-folders tree}}
    </div>
  {{/if}}
</div>

{{#each recipes}}
  <a class="bc-rec {{#if selected}}selected{{/if}} {{#if locked}}bc-locked{{/if}}" data-id="{{uuid}}">
    <img src="{{img}}" alt="">
    <span class="bc-n">{{name}}</span>
    {{#if locked}}
      <i class="fas {{kindIcon}} fa-fw bc-state" data-tooltip="{{localize 'beaversCrafting.knowledge.notKnownTag'}}"></i>
    {{else if craftable}}
      <i class="fas {{kindIcon}} fa-fw bc-state ok" data-tooltip="{{localize 'beaversCrafting.crafting-app.craftableNow'}}"></i>
    {{else}}
      <i class="fas {{kindIcon}} fa-fw bc-state" data-tooltip="{{localize 'beaversCrafting.crafting-app.notCraftable'}}"></i>
    {{/if}}
  </a>
{{/each}}
{{#each folders}}
  <div class="bc-folder {{#if collapsed}}collapsed{{/if}}" data-path="{{path}}">
    <a class="bc-fold">
      <i class="fas fa-chevron-down fa-fw"></i>
      <span class="bc-n">{{name}}</span>
      <span class="bc-c">{{count}}</span>
    </a>
    <div class="bc-folder-content">
      {{> beavers-crafting-app-folders this}}
    </div>
  </div>
{{/each}}

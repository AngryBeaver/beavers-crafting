<div class="bc-body">
  <aside class="bc-side">
    <div class="bc-tools">
      <label class="bc-field">
        <i class="fas fa-magnifying-glass fa-fw"></i>
        <input class="search" type="text" value="{{search}}"
               placeholder="{{localize 'beaversCrafting.crafting-app.searchPlaceholder'}}"
               aria-label="{{localize 'beaversCrafting.crafting-app.searchPlaceholder'}}" autofocus/>
      </label>
      <div class="bc-trow">
        <label class="bc-field">
          <i class="fas fa-filter fa-fw"></i>
          <select class="filter" aria-label="{{localize 'beaversCrafting.crafting-app.filter'}}">
            {{selectOptions
              (beavers-object
                "2" (localize "beaversCrafting.crafting-app.search.all")
                "1" (localize "beaversCrafting.crafting-app.search.available")
                "0" (localize "beaversCrafting.crafting-app.search.usable")
                "3" (localize "beaversCrafting.crafting-app.search.own")
              )
              selected=filter
            }}
          </select>
        </label>
        <button type="button" class="bc-ib collapse-all"
                data-tooltip="{{localize 'beaversCrafting.crafting-app.collapseAll'}}"
                aria-label="{{localize 'beaversCrafting.crafting-app.collapseAll'}}">
          <i class="fas fa-angles-up fa-fw"></i>
        </button>
      </div>
    </div>
    <nav class="bc-list">
      {{> beavers-crafting-app-folders tree}}
    </nav>
    <div class="bc-sfoot"><span class="bc-dot ok"></span>{{craftableText}}</div>
  </aside>
  <section class="bc-main"></section>
</div>

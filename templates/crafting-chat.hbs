{{#*inline "bcc-chip"}}
    <span class="bcc-it {{cls}}"><img src="{{img}}" alt=""><span>{{name}}</span>{{#if (eq cls "bad")}}<i class="fas fa-xmark"></i>{{/if}}</span>
{{/inline}}

<div class="beavers-crafting bcc {{#unless card.ok}}bad{{/unless}}">
    <div class="bcc-head">
        <img src="{{card.img}}" alt="">
        <div class="bcc-t">
            <div class="n">{{card.name}}</div>
            <div class="s">
                {{#if card.pips}}
                    <span class="bcc-pips">{{#each card.pips}}{{#if sep}}<span class="sep"></span>{{else}}<i class="{{cls}}"></i>{{/if}}{{/each}}</span>
                {{/if}}
                <span>{{card.sub}}</span>
            </div>
        </div>
        {{#if card.ok}}
            <span class="bcc-chip"><i class="fas fa-check"></i>{{localize "beaversCrafting.actorSheet.done"}}</span>
        {{else}}
            <span class="bcc-chip"><i class="fas fa-xmark"></i>{{localize "beaversCrafting.actorSheet.failed"}}</span>
        {{/if}}
    </div>
    {{#if card.reason}}
        <div class="bcc-why"><i class="fas fa-triangle-exclamation"></i><span>{{card.reason}}</span></div>
    {{/if}}
    {{#if card.produced.length}}
        <div class="bcc-out">
            {{#each card.produced}}
                <div class="bcc-prod {{#if lost}}lost{{/if}}" data-type="output" data-id="{{uuid}}">
                    <img src="{{img}}" alt="">
                    <span class="n">{{name}}</span>
                    <span class="q">×{{quantity}}</span>
                </div>
            {{/each}}
        </div>
    {{/if}}
    {{#if card.used.length}}
        <div class="bcc-grp">
            <b>{{localize "beaversCrafting.chat.used"}}</b>
            <div class="bcc-items">
                {{#each card.used}}{{> bcc-chip}}{{/each}}
            </div>
        </div>
    {{/if}}
    {{#if card.tools.length}}
        <div class="bcc-grp">
            <b>{{localize "beaversCrafting.chat.tools"}}</b>
            <div class="bcc-items">
                {{#each card.tools}}{{> bcc-chip}}{{/each}}
            </div>
        </div>
    {{/if}}
</div>
